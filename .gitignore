# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# Environments
.env
.venv
env/
venv/
ENV/

# Large Datasets & External Storage (Do NOT commit to git)
datasets/*
!datasets/.gitkeep
data/*
!data/.gitkeep
*.zip
*.tar
*.tar.gz
*.7z

# Model Weights & Checkpoints
*.pt
*.pth
*.onnx
*.engine
models/*
!models/.gitkeep

# Preprocessing & Test Outputs
tests/output/*
!tests/output/.gitkeep
runs/
reports/*
!reports/.gitkeep

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
